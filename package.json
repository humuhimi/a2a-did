{
  "name": "a2a-did",
  "version": "0.1.1",
  "description": "DID-based authentication for A2A Protocol - Sign and verify agent messages with did:web and did:ethr",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "author": "humuhimi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humuhimi/a2a-did.git"
  },
  "homepage": "https://github.com/humuhimi/a2a-did#readme",
  "bugs": {
    "url": "https://github.com/humuhimi/a2a-did/issues"
  },
  "keywords": [
    "a2a",
    "did",
    "agent",
    "authentication",
    "decentralized-identity",
    "did-web",
    "did-ethr",
    "jws",
    "ai-agent"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm test && npm run build && rm -rf dist/__tests__"
  },
  "dependencies": {
    "@helia/verified-fetch": "^5.1.1",
    "@noble/secp256k1": "^3.0.0",
    "did-jwt": "^8.0.18",
    "did-resolver": "^4.1.0",
    "ethers": "^6.16.0",
    "ethr-did": "^3.0.38",
    "ethr-did-resolver": "^11.0.5",
    "multiformats": "^13.4.2",
    "uint8arrays": "^5.1.0",
    "web-did-resolver": "^2.0.32"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
